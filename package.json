{
  "name": "idle",
  "version": "0.1.0",
  "private": true,
  "description": "An abstract-numbers idle game built entirely from open-licensed assets (game-icons.net icons, Kenney/OpenGameArt CC0 audio, OEIS sequence data).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.engine.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run test && npm run format:check",
    "assets": "node scripts/assets/build-assets.mjs",
    "playtest": "node scripts/dev/playtest.mjs",
    "sim": "node scripts/sim/run.mjs",
    "bench": "node scripts/bench/run.mjs",
    "ci": "node scripts/ci/ci.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LoudAnd/Idle.git"
  },
  "license": "MIT",
  "dependencies": {
    "break_eternity.js": "2.1.3",
    "preact": "^11.0.0"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@testing-library/preact": "^3.2.4",
    "@types/node": "^26.6.4",
    "fast-check": "^4.10.2",
    "jsdom": "^29.1.1",
    "playwright": "1.56.1",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
